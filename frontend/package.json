{
  "name": "healthcom-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "concurrently -k -n vite,electron -c cyan,magenta \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "app:prod": "npm run build && electron ."
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^37.3.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.5"
  }
}
